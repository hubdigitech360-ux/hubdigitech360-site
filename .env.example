# Copiez ce fichier en .env et renseignez de vraies valeurs — jamais ce
# fichier lui-même.

# URL de connexion au logiciel Performa360 (bouton "Se connecter" dans
# l'en-tête et sur la page d'accueil). Doit être une URL publique en
# production, ex. https://app.performa360.cm/login
NEXT_PUBLIC_APP_URL=http://localhost:3000/login

# URL de l'Interactive Demo Engine de Performa360 (bouton "Essayer
# Performa360", CTA primaire de l'en-tête et de la page d'accueil). Doit
# être une URL publique en production, ex. https://app.performa360.cm/demo
NEXT_PUBLIC_DEMO_URL=http://localhost:3000/demo

# Secret de signature des sessions admin (/admin) — obligatoire en
# production, sinon le serveur refuse de démarrer (voir src/lib/auth.ts).
# Générer une vraie valeur avec : openssl rand -hex 32
AUTH_SECRET=

# Optionnel — chemin de la base SQLite sur un hébergeur à disque persistant
# (VPS/Railway/Render/Fly.io). Sans cette variable : dev.db à la racine du
# projet (comportement local par défaut).
DB_PATH=
